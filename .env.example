# Server
PORT=20128
HOSTNAME=0.0.0.0
NEXT_PUBLIC_BASE_URL=http://localhost:20128

# Auth — CHANGE THESE in production
# Run `npm run setup` to auto-generate secure values
JWT_SECRET=your-jwt-secret-change-this
INITIAL_PASSWORD=123456
API_KEY_SECRET=your-api-key-secret-change-this
MACHINE_ID_SALT=your-machine-id-salt-change-this

# Storage
DATA_DIR=

# Cloud sync (optional)
NEXT_PUBLIC_CLOUD_URL=

# Logging
LOG_LEVEL=INFO

# Request logging / observability
# Priority chain: ENABLE_REQUEST_LOGS (force) > dashboard UI setting > OBSERVABILITY_ENABLED fallback.
# - ENABLE_REQUEST_LOGS=true  forces request logs ON regardless of UI.
# - ENABLE_REQUEST_LOGS=false forces request logs OFF (never logs API keys/tokens).
# - Unset → dashboard profile setting (default: off, opt-in).
ENABLE_REQUEST_LOGS=false
OBSERVABILITY_ENABLED=true
OBSERVABILITY_MAX_RECORDS=5000
OBSERVABILITY_BATCH_SIZE=50
OBSERVABILITY_FLUSH_INTERVAL_MS=5000

# Proxy (optional)
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=

# Headroom (optional)
# HEADROOM_URL=http://localhost:8787

# Cookie security
AUTH_COOKIE_SECURE=false
TRUST_PROXY=false

# Tunnel (optional)
# TUNNEL_WORKER_URL=
# TUNNEL_TRANSPORT_PROTOCOL=
