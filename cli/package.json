{
  "name": "toolnetapi",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "license": "MIT",
  "description": "ToolNet API CLI — AI coding agent for the terminal",
  "bin": {
    "toolnet": "./bin/toolnet.js",
    "toolnetapi": "./bin/toolnet.js"
  },
  "scripts": {
    "dev": "bun src/index.tsx",
    "build": "bun build src/index.tsx --target=bun --outdir=dist",
    "start": "bun dist/index.js",
    "typecheck": "tsc --noEmit",
    "pack:cli": "bun run build && npm pack --pack-destination ..",
    "publish:cli": "bun run build && npm publish"
  },
  "dependencies": {
    "@opentui/core": "0.4.5",
    "@opentui/solid": "0.4.5",
    "@opentui/keymap": "0.4.5",
    "solid-js": "1.9.10",
    "opentui-spinner": "0.0.7",
    "strip-ansi": "7.1.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "5.8.2"
  }
}
